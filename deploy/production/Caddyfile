# Global options must stay first in this file.
{
	# Activity Origins get certificates on demand (ADR-0011). Before issuing
	# one, Caddy asks the production activity proxy, which approves only
	# enabled registered applications and relays questions about nightly hosts
	# to the nightly proxy (see the :14700 site below).
	on_demand_tls {
		ask http://syrnike13-activity-proxy:14707/_caddy/ask
	}
}

# Per-project Caddy configs live outside this repository. The directory is mounted
# into the container (see compose.override.yml on the server), so deploys that ship
# this file never touch them.
import /etc/caddy/sites/*.caddyfile

# Services are updated by starting a replacement container next to the running
# one, so upstreams are network aliases shared by both. Requests that hit a
# container while it stops are retried on the other one. The production
# container names after the alias only cover the first deploy that adds the
# aliases; remove them once every production service has been rolled out.
(rolling_upstream) {
	lb_policy first
	lb_try_duration 10s
	lb_try_interval 250ms
	fail_duration 2s
}

{$HOSTNAME} {
	route /api* {
		uri strip_prefix /api
		reverse_proxy http://syrnike13-api:14702 http://syrnike13-api-1:14702 {
			import rolling_upstream
			header_down Location "^/" "/api/"
		}
	}

	route /ws {
		uri strip_prefix /ws
		reverse_proxy http://syrnike13-events:14703 http://syrnike13-events-1:14703 {
			import rolling_upstream
			header_down Location "^/" "/ws/"
		}
	}

	route /autumn* {
		uri strip_prefix /autumn
		reverse_proxy http://syrnike13-autumn:14704 http://syrnike13-autumn-1:14704 {
			import rolling_upstream
			header_down Location "^/" "/autumn/"
		}
	}

	route /january* {
		uri strip_prefix /january
		reverse_proxy http://syrnike13-january:14705 http://syrnike13-january-1:14705 {
			import rolling_upstream
			header_down Location "^/" "/january/"
		}
	}

	route /gifbox* {
		uri strip_prefix /gifbox
		reverse_proxy http://syrnike13-gifbox:14706 http://syrnike13-gifbox-1:14706 {
			import rolling_upstream
			header_down Location "^/" "/gifbox/"
		}
	}

	route /livekit* {
		uri strip_prefix /livekit
		# The second node (livekit-b profile) takes signalling while the first one
		# is replaced; any node routes a participant to the node of its room.
		reverse_proxy http://syrnike13-livekit-1:7880 http://syrnike13-livekit:7880 {
			import rolling_upstream
			header_down Location "^/" "/livekit/"
		}
	}

	route /ingress* {
		uri strip_prefix /ingress
		reverse_proxy http://syrnike13-voice-ingress:8500 http://syrnike13-voice-ingress-1:8500 {
			import rolling_upstream
			header_down Location "^/" "/ingress/"
		}
	}

	@stable_download path /downloads/syrnike13.dmg /downloads/syrnike13-setup.exe /downloads/syrnike13.AppImage
	handle @stable_download {
		root * /srv/desktop
		uri strip_prefix /downloads
		header Cache-Control "no-cache"
		file_server
	}

	handle_path /downloads/desktop/* {
		root * /srv/desktop

		@manifest path_regexp manifest \.yml$
		header @manifest Cache-Control "no-cache"

		@artifacts path_regexp artifact \.(exe|zip|dmg|AppImage|blockmap|7z)$
		header @artifacts Cache-Control "public, max-age=31536000, immutable"

		file_server
	}

	@stable_apk path /downloads/syrnike13.apk
	handle @stable_apk {
		root * /srv/mobile
		uri strip_prefix /downloads
		header Cache-Control "no-cache"
		file_server
	}

	# Android app: release feed, APKs and over-the-air JS updates. The app asks
	# for /manifest with its runtime version (Expo Updates protocol v1); the
	# matching static manifest is served, or 204 when that runtime has none.
	handle_path /downloads/mobile/* {
		root * /srv/mobile

		@manifest {
			path /manifest
			header_regexp runtime Expo-Runtime-Version ^[A-Za-z0-9._-]+$
		}
		handle @manifest {
			header expo-protocol-version 1
			header expo-sfv-version 0
			header Cache-Control "private, max-age=0"

			@update file /updates/{re.runtime.0}/manifest.json
			handle @update {
				rewrite * /updates/{re.runtime.0}/manifest.json
				file_server
			}
			handle {
				respond 204
			}
		}

		@feed path /latest.json
		header @feed Cache-Control "no-cache"

		@artifacts path_regexp artifact \.apk$|^/assets/
		header @artifacts Cache-Control "public, max-age=31536000, immutable"

		file_server
	}

	# Обновление service worker не допускает редиректов: kill-switch должен
	# оставаться доступен на исходном origin, включая старый /app scope.
	@legacy_worker path /serviceWorker.js /app/serviceWorker.js
	route @legacy_worker {
		rewrite * /sw.js
		reverse_proxy http://syrnike13-landing:5000 http://syrnike13-landing-1:5000 {
			import rolling_upstream
		}
	}

	# Сначала меняем путь, затем редиректим весь URI вместе с query.
	@legacy_app path /app /app/*
	route @legacy_app {
		uri strip_prefix /app
		redir https://{$APP_HOSTNAME:app.syrnike13.ru}{uri} 308
	}

	@legacy_app_paths path /m /m/* /login /login/* /invite /invite/* /verify/* /desktop/* /dev/* /admin /admin/*
	redir @legacy_app_paths https://{$APP_HOSTNAME:app.syrnike13.ru}{uri} 308

	reverse_proxy http://syrnike13-landing:5000 http://syrnike13-landing-1:5000 {
		import rolling_upstream
	}
}

{$APP_HOSTNAME:app.syrnike13.ru} {
	reverse_proxy http://syrnike13-web:5000 http://syrnike13-web-1:5000 {
		import rolling_upstream
	}
}

{$ADMIN_HOSTNAME:admin.syrnike13.ru} {
	reverse_proxy http://syrnike13-admin:5000 http://syrnike13-admin-1:5000 {
		import rolling_upstream
	}
}

{$NIGHTLY_HOSTNAME:beta.syrnike13.ru} {
	route /api* {
		uri strip_prefix /api
		reverse_proxy http://syrnike13-nightly-api:14702 {
			import rolling_upstream
			header_down Location "^/" "/api/"
		}
	}

	route /ws {
		uri strip_prefix /ws
		reverse_proxy http://syrnike13-nightly-events:14703 {
			import rolling_upstream
			header_down Location "^/" "/ws/"
		}
	}

	route /autumn* {
		uri strip_prefix /autumn
		reverse_proxy http://syrnike13-nightly-autumn:14704 {
			import rolling_upstream
			header_down Location "^/" "/autumn/"
		}
	}

	route /january* {
		uri strip_prefix /january
		reverse_proxy http://syrnike13-nightly-january:14705 {
			import rolling_upstream
			header_down Location "^/" "/january/"
		}
	}

	route /gifbox* {
		uri strip_prefix /gifbox
		reverse_proxy http://syrnike13-nightly-gifbox:14706 {
			import rolling_upstream
			header_down Location "^/" "/gifbox/"
		}
	}

	route /livekit* {
		uri strip_prefix /livekit
		reverse_proxy http://syrnike13-nightly-livekit:7880 {
			import rolling_upstream
			header_down Location "^/" "/livekit/"
		}
	}

	route /ingress* {
		uri strip_prefix /ingress
		reverse_proxy http://syrnike13-nightly-voice-ingress:8500 {
			import rolling_upstream
			header_down Location "^/" "/ingress/"
		}
	}

	@legacy_worker path /serviceWorker.js /app/serviceWorker.js
	route @legacy_worker {
		rewrite * /sw.js
		reverse_proxy http://syrnike13-nightly-landing:5000 {
			import rolling_upstream
		}
	}

	@legacy_app path /app /app/*
	route @legacy_app {
		uri strip_prefix /app
		redir https://{$NIGHTLY_APP_HOSTNAME:app.beta.syrnike13.ru}{uri} 308
	}

	@legacy_app_paths path /m /m/* /login /login/* /invite /invite/* /verify/* /desktop/* /dev/* /admin /admin/*
	redir @legacy_app_paths https://{$NIGHTLY_APP_HOSTNAME:app.beta.syrnike13.ru}{uri} 308

	reverse_proxy http://syrnike13-nightly-landing:5000 {
		import rolling_upstream
	}
}

{$NIGHTLY_APP_HOSTNAME:app.beta.syrnike13.ru} {
	reverse_proxy http://syrnike13-nightly-web:5000 {
		import rolling_upstream
	}
}

{$NIGHTLY_ADMIN_HOSTNAME:admin.beta.syrnike13.ru} {
	reverse_proxy http://syrnike13-nightly-admin:5000 {
		import rolling_upstream
	}
}

# Activity Origins: {id}.activities.syrnike13.ru (production) and
# {id}.activities.beta.syrnike13.ru (nightly). Each environment's proxy picks
# the application from the Host header and serves it from its own registry.
*.activities.syrnike13.ru {
	tls {
		on_demand
	}
	reverse_proxy http://syrnike13-activity-proxy:14707 {
		import rolling_upstream
	}
}

*.activities.beta.syrnike13.ru {
	tls {
		on_demand
	}
	reverse_proxy http://syrnike13-nightly-activity-proxy:14707 {
		import rolling_upstream
	}
}

# Internal relay (port not published): the production activity proxy is not on
# the edge network, so it forwards on-demand TLS questions about nightly hosts
# here, and Caddy passes them to the nightly proxy.
http://:14700 {
	handle /_caddy/ask {
		reverse_proxy http://syrnike13-nightly-activity-proxy:14707
	}
	handle {
		respond 404
	}
}
