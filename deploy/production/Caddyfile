		import rolling_upstream
	}
}

{$NIGHTLY_APP_HOSTNAME:app.beta.syrnike13.ru} {
	reverse_proxy http://syrnike13-nightly-web:5000 {
		import rolling_upstream
	}
}

{$NIGHTLY_ADMIN_HOSTNAME:admin.beta.syrnike13.ru} {
	reverse_proxy http://syrnike13-nightly-admin:5000 {
		import rolling_upstream
	}
}
