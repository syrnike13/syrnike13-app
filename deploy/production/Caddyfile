# Per-project Caddy configs live outside this repository. The directory is mounted
# into the container (see compose.override.yml on the server), so deploys that ship
# this file never touch them.
import /etc/caddy/sites/*.caddyfile

# Services are updated by starting a replacement container next to the running
# one, so upstreams are network aliases shared by both. Requests that hit a
# container while it stops are retried on the other one. The production
# container names after the alias only cover the first deploy that adds the
# aliases; remove them once every production service has been rolled out.
(rolling_upstream) {
	lb_policy first
	lb_try_duration 10s
	lb_try_interval 250ms
	fail_duration 2s
}

{$HOSTNAME} {
	route /app/serviceWorker.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-store, no-cache, must-revalidate"
		respond "self.addEventListener('install', event => self.skipWaiting()); self.addEventListener('activate', event => event.waitUntil((async () => { const keys = await caches.keys(); await Promise.all(keys.map(key => caches.delete(key))); await self.registration.unregister(); const clients = await self.clients.matchAll({ type: 'window', includeUncontrolled: true }); for (const client of clients) client.navigate('/'); })()));" 200
	}

	route /app/assets* {
		uri strip_prefix /app
		reverse_proxy http://syrnike13-web:5000 http://syrnike13-web-1:5000 {
			import rolling_upstream
		}
	}

	route /app/manifest.webmanifest {
		uri strip_prefix /app
		reverse_proxy http://syrnike13-web:5000 http://syrnike13-web-1:5000 {
			import rolling_upstream
		}
	}

	route /api* {
		uri strip_prefix /api
		reverse_proxy http://syrnike13-api:14702 http://syrnike13-api-1:14702 {
			import rolling_upstream
			header_down Location "^/" "/api/"
		}
	}

	route /ws {
		uri strip_prefix /ws
		reverse_proxy http://syrnike13-events:14703 http://syrnike13-events-1:14703 {
			import rolling_upstream
			header_down Location "^/" "/ws/"
		}
	}

	route /autumn* {
		uri strip_prefix /autumn
		reverse_proxy http://syrnike13-autumn:14704 http://syrnike13-autumn-1:14704 {
			import rolling_upstream
			header_down Location "^/" "/autumn/"
		}
	}

	route /january* {
		uri strip_prefix /january
		reverse_proxy http://syrnike13-january:14705 http://syrnike13-january-1:14705 {
			import rolling_upstream
			header_down Location "^/" "/january/"
		}
	}

	route /gifbox* {
		uri strip_prefix /gifbox
		reverse_proxy http://syrnike13-gifbox:14706 http://syrnike13-gifbox-1:14706 {
			import rolling_upstream
			header_down Location "^/" "/gifbox/"
		}
	}

	route /livekit* {
		uri strip_prefix /livekit
		# The second node (livekit-b profile) takes signalling while the first one
		# is replaced; any node routes a participant to the node of its room.
		reverse_proxy http://syrnike13-livekit-1:7880 http://syrnike13-livekit:7880 {
			import rolling_upstream
			header_down Location "^/" "/livekit/"
		}
	}

	route /ingress* {
		uri strip_prefix /ingress
		reverse_proxy http://syrnike13-voice-ingress:8500 http://syrnike13-voice-ingress-1:8500 {
			import rolling_upstream
			header_down Location "^/" "/ingress/"
		}
	}

	@stable_download path /downloads/syrnike13.dmg /downloads/syrnike13-setup.exe /downloads/syrnike13.AppImage
	handle @stable_download {
		root * /srv/desktop
		uri strip_prefix /downloads
		header Cache-Control "no-cache"
		file_server
	}

	handle_path /downloads/desktop/* {
		root * /srv/desktop

		@manifest path_regexp manifest \.yml$
		header @manifest Cache-Control "no-cache"

		@artifacts path_regexp artifact \.(exe|zip|dmg|AppImage|blockmap|7z)$
		header @artifacts Cache-Control "public, max-age=31536000, immutable"

		file_server
	}

	reverse_proxy http://syrnike13-web:5000 http://syrnike13-web-1:5000 {
		import rolling_upstream
	}
}

{$ADMIN_HOSTNAME:admin.syrnike13.ru} {
	reverse_proxy http://syrnike13-admin:5000 http://syrnike13-admin-1:5000 {
		import rolling_upstream
	}
}

